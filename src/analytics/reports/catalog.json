  {
    "id": "active-members-demographics",
    "category": "people",
    "visibility": "public",
    "cost": "light",
    "requires": {
      "tables": ["outing", "rower"]
    },
    "params": [
      {
        "name": "season",
        "type": "season",
        "required": true,
        "default": "current"
      }
    ],
    "chart": {
      "type": "bar",
      "x": "age_group",
      "y": ["active_rowers"],
      "series": "gender",
      "stacked": true,
      "orientation": "horizontal"
    },
    "coverage": {
      "column": "gender",
      "sql": "SELECT COUNT(DISTINCT CASE WHEN gender IS NOT NULL THEN rower_id END) AS known, COUNT(DISTINCT rower_id) AS total FROM v_outing_rowers WHERE season = :season AND counts_in_stats = 1 AND is_rowing = 1 AND rower_status = 'member'"
    },
    "notes": ["km", "membersOnly", "motorboat", "excluded", "v1Coxes"],
    "mcpDescription": "Members who rowed at least once this season: youth (18 or younger in the year) and adults. For grant applications. Columns: age_group, gender, active_rowers, outings, km."
  },
