[
  {
    "id": "season-overview",
    "category": "overview",
    "visibility": "public",
    "cost": "light",
    "requires": {
      "tables": ["outing"]
    },
    "params": [
      {
        "name": "season",
        "type": "season",
        "required": true,
        "default": "current"
      }
    ],
    "chart": {
      "type": "kpi",
      "items": [
        {
          "value": "outings",
          "compare": "outings_prev",
          "format": "integer",
          "higherIsBetter": true
        },
        {
          "value": "active_rowers",
          "compare": "active_rowers_prev",
          "format": "integer",
          "higherIsBetter": true
        },
        {
          "value": "km",
          "compare": "km_prev",
          "format": "km",
          "higherIsBetter": true,
          "hideWhenNull": true
        },
        {
          "value": "hours",
          "compare": "hours_prev",
          "format": "hours",
          "higherIsBetter": true
        },
        {
          "value": "coached_pct",
          "compare": "coached_pct_prev",
          "format": "percent",
          "hideWhenNull": true
        }
      ]
    },
    "coverage": {
      "column": "distance",
      "sql": "SELECT COUNT(distance_m) AS known, COUNT(*) AS total FROM v_outings WHERE season = :season AND counts_in_stats = 1"
    },
    "notes": ["multiDay", "km", "motorboat", "excluded", "v1Coxes"],
    "mcpDescription": "Outings, active rowers, kilometers, hours on the water and coached share, compared with the same period last season. Columns: outings, outings_prev, active_rowers, active_rowers_prev, km, km_prev, hours, hours_prev, coached_pct, coached_pct_prev, is_partial, cutoff_date."
  },
  {
    "id": "yoy-monthly",
    "category": "overview",
    "visibility": "public",
    "cost": "light",
    "requires": {
      "tables": ["outing"]
    },
    "params": [
      {
        "name": "season",
        "type": "season",
        "required": true,
        "default": "current"
      },
      {
        "name": "metric",
        "type": "choice",
        "required": true,
        "default": "outings",
        "options": [
          {
            "value": "outings"
          },
          {
            "value": "participations"
          },
          {
            "value": "active_rowers"
          },
          {
            "value": "km"
          },
          {
            "value": "hours"
          }
        ]
      }
    ],
    "chart": {
      "type": "bar",
      "x": "month",
      "y": ["value", "value_prev"],
      "orientation": "vertical",
      "stacked": false,
      "labelKeys": {
        "value": "analytics.codes.metric.{metric}",
        "value_prev": "analytics.reports.labels.previous.{metric}"
      }
    },
    "notes": ["multiDay", "km", "motorboat", "excluded", "v1Coxes"],
    "mcpDescription": "Pick the measure: outings, participations, active rowers, kilometers or hours. Columns: month, value, value_prev."
  },
  {
    "id": "yoy-cumulative",
