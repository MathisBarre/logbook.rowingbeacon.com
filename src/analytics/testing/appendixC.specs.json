      "sort": "desc"
    },
    "params": [
      {
        "name": "season",
        "type": "season",
        "required": true,
        "default": "current"
      }
    ]
  },
  "safety-issues": {
    "chart": {
      "type": "table"
    },
    "params": [
      {
        "name": "season",
        "type": "season",
        "required": true,
        "default": "current"
      },
      {
        "name": "tolerance_min",
        "type": "integer",
        "required": true,
        "default": 15,
        "min": 0,
        "max": 600
      }
    ]
  },
  "safety-summary": {
    "chart": {
      "type": "bar",
      "x": "month",
      "y": ["late_returns", "no_estimated_end", "not_closed"],
      "stacked": true
    },
    "params": [
      {
        "name": "season",
        "type": "season",
        "required": true,
        "default": "current"
      },
      {
        "name": "tolerance_min",
        "type": "integer",
        "required": true,
        "default": 15,
        "min": 0,
        "max": 600
      }
    ]
  },
  "incidents-per-boat": {
    "chart": {
      "type": "bar",
      "x": "boat_name",
      "y": ["incidents"],
      "orientation": "horizontal",
