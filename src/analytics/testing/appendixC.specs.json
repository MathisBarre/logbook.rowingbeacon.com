      "stacked": true,
      "limit": 25
    },
    "params": [
      {
        "name": "season",
        "type": "season",
        "required": true,
        "default": "current"
      }
    ]
  },
  "guests": {
    "chart": {
      "type": "bar",
      "x": "month",
      "y": ["guest_participations"]
    },
    "params": [
      {
        "name": "season",
        "type": "season",
        "required": true,
        "default": "current"
      }
    ]
  }
}
