[
  { "sql": "SELECT 1", "expect": "ok", "paramNames": [] },
  { "sql": "select 1", "expect": "ok", "paramNames": [] },
  { "sql": "  \n\t SELECT 1", "expect": "ok" },
  { "sql": "select\t*\nfrom v_boats", "expect": "ok" },
  { "sql": "SELECT 1;", "expect": "ok", "cleaned": "SELECT 1" },
  { "sql": "SELECT 1;\n\n", "expect": "ok", "cleaned": "SELECT 1" },
  { "sql": "SELECT 1;  -- done", "expect": "ok", "cleaned": "SELECT 1" },
  { "sql": "SELECT 1; /* end */  ", "expect": "ok", "cleaned": "SELECT 1" },
  {
    "sql": "SELECT 1 /* ; */ ; ",
    "expect": "ok",
    "cleaned": "SELECT 1 /* ; */"
  },
  { "sql": "SELECT 1; SELECT 2", "expect": "multiple_statements" },
  { "sql": "SELECT 1; DELETE FROM outing", "expect": "multiple_statements" },
  { "sql": "SELECT 1;;", "expect": "multiple_statements" },
  {
    "sql": "SELECT 1 -- c\n; DELETE FROM outing",
    "expect": "multiple_statements"
  },
  {
    "sql": "SELECT 'x;'; DELETE FROM outing",
    "expect": "multiple_statements",
    "note": "a statement hidden after a string containing ;"
  },
  { "sql": "SELECT ';' AS semi", "expect": "ok" },
  { "sql": "SELECT 'a;b''c' AS s", "expect": "ok" },
  { "sql": "SELECT \"a;b\" FROM v_outings", "expect": "ok" },
  { "sql": "SELECT \"a\"\";b\" FROM t", "expect": "ok" },
  { "sql": "SELECT [a;b] FROM t", "expect": "ok" },
  { "sql": "SELECT `a;b` FROM t", "expect": "ok" },
  { "sql": "SELECT '--' || 'x'", "expect": "ok" },
  { "sql": "SELECT '/*' || 'x'", "expect": "ok" },
  { "sql": "SELECT x'41'", "expect": "ok" },
  {
    "sql": "SELECT 1 -- comment ; DELETE FROM outing",
    "expect": "ok",
    "note": "a line comment runs to the end of the text"
  },
  { "sql": "/* lead */ SELECT 1", "expect": "ok" },
  { "sql": "-- lead\nSELECT 1", "expect": "ok" },
  {
    "sql": "SELECT 1 /* a /* b */",
    "expect": "ok",
    "note": "comments do not nest: the first */ closes"
  },
  { "sql": "SELECT 1 /* never closed", "expect": "syntax", "offset": 9 },
  { "sql": "SELECT 1; /* never closed", "expect": "syntax", "offset": 10 },
  { "sql": "SELECT 'abc", "expect": "syntax", "offset": 7 },
  { "sql": "SELECT \"abc", "expect": "syntax", "offset": 7 },
  { "sql": "SELECT [abc", "expect": "syntax", "offset": 7 },
  { "sql": "SELECT `abc", "expect": "syntax", "offset": 7 },
  {
    "sql": "SELECT 'é', 'x",
    "expect": "syntax",
    "offset": 12,
    "note": "offsets count UTF-16 code units, not bytes"
  },
  { "sql": "", "expect": "syntax" },
  { "sql": "  -- only a comment", "expect": "syntax" },
  { "sql": ";", "expect": "syntax" },
  { "sql": "WITH x AS (SELECT 1) SELECT * FROM x", "expect": "ok" },
  {
    "sql": "WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM c WHERE x < 5) SELECT x FROM c",
    "expect": "ok"
  },
  {
    "sql": "WITH x AS (DELETE FROM outing RETURNING id) SELECT * FROM x",
    "expect": "ok",
    "note": "the lexer lets it through; prepare and the authorizer refuse it"
  },
  { "sql": "VALUES (1), (2)", "expect": "ok" },
  { "sql": "values (1)", "expect": "ok" },
  { "sql": "PRAGMA table_info(rower)", "expect": "not_read_only" },
  { "sql": "pragma writable_schema = 1", "expect": "not_read_only" },
  { "sql": "ATTACH DATABASE 'x.db' AS x", "expect": "not_read_only" },
  { "sql": "DETACH DATABASE x", "expect": "not_read_only" },
  { "sql": "INSERT INTO outing (id) VALUES ('x')", "expect": "not_read_only" },
  { "sql": "UPDATE rower SET first_name = 'x'", "expect": "not_read_only" },
  { "sql": "DELETE FROM outing", "expect": "not_read_only" },
  {
    "sql": "REPLACE INTO setting VALUES ('a', 'b')",
    "expect": "not_read_only"
  },
  { "sql": "DROP TABLE outing", "expect": "not_read_only" },
  { "sql": "CREATE TABLE x (a)", "expect": "not_read_only" },
  { "sql": "ALTER TABLE outing ADD COLUMN x", "expect": "not_read_only" },
  { "sql": "VACUUM", "expect": "not_read_only" },
  { "sql": "EXPLAIN SELECT 1", "expect": "not_read_only" },
  { "sql": "SELECTX 1", "expect": "not_read_only" },
  { "sql": "(SELECT 1)", "expect": "not_read_only" },
  {
    "sql": "SELECT :season, @boat_id, $limit",
    "expect": "ok",
    "paramNames": ["season", "boat_id", "limit"]
  },
  { "sql": "SELECT :a, :a, :b", "expect": "ok", "paramNames": ["a", "b"] },
  {
    "sql": "SELECT ':not_a_param', \":nope\", [:x]",
    "expect": "ok",
    "paramNames": []
  },
  {
    "sql": "SELECT 1 -- :ignored\n, 2 /* @also */",
    "expect": "ok",
    "paramNames": []
  },
  {
    "sql": "SELECT * FROM v_outings WHERE season = :season;",
    "expect": "ok",
    "paramNames": ["season"],
    "cleaned": "SELECT * FROM v_outings WHERE season = :season"
  },
  { "sql": "SELECT ?1", "expect": "invalid_param" },
  { "sql": "SELECT ?", "expect": "invalid_param" },
  { "sql": "SELECT * FROM t WHERE a = ? AND b = :b", "expect": "invalid_param" }
]
